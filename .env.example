# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（P1-1 实验选择中文 BGE large）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 仅查询侧前缀；留空表示不添加
EMBEDDING_QUERY_INSTRUCTION=

# 文件存储路径（相对于项目根目录）
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma_db
METADATA_DB_PATH=./data/metadata.db

# 文本切分参数
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# P1-3 正式评估选择的递归语义切分策略
CHUNK_STRATEGY=recursive
# bge-large-zh-v1.5 最大 512 token，保留 32 token 安全余量
CHUNK_MAX_TOKENS=480

# 检索返回数量
RETRIEVAL_TOP_K=5
# Chroma cosine distance 越小越相似；P1-4 真实评测校准值
RETRIEVAL_DISTANCE_THRESHOLD=0.67
# P2-1 实验开关：dense / bm25 / hybrid；通过消融验收前保持 dense
RETRIEVAL_MODE=dense
BM25_TOP_K=15
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
# P2-3 调试面板；开启后 API 会返回未入选候选的完整 chunk，仅限可信环境
RETRIEVAL_TRACE_ENABLED=false
# structured-v1 引用原文预览；返回完整来源单元和结构化 blocks，仅限可信环境
# 生产环境或公开部署时必须设为 false
CITATION_PREVIEW_ENABLED=false
CITATION_PREVIEW_MAX_PAGE_CHARS=200000
CITATION_PREVIEW_MAX_DOCUMENT_CHARS=500000

# 本地单用户持久化对话的确定性历史窗口与恢复边界
CONVERSATION_HISTORY_MESSAGES=12
CONVERSATION_HISTORY_MAX_TOKENS=1500
CONVERSATION_MESSAGE_MAX_CHARS=8000
CONVERSATION_MAX_MESSAGES=200
CONVERSATION_PENDING_TIMEOUT_SECONDS=300

# P1-5 高质量模式：Dense top15 经 bge-reranker-v2-m3 精排后返回 top5
# CPU 首次查询需要加载模型，实测平均总耗时约 9.3 秒；资源有限时可设为 false
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=15
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# ─── 视觉 / OCR（多模态模型 API，独立于问答 LLM） ──────────
# MiMo 官方开放平台等 OpenAI 兼容端点；默认全部关闭，不影响现有链路。
# OCR_ENABLED=true 时必须同时配置 VISION_API_KEY 与 VISION_BASE_URL。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=mimo-v2.5
# 总开关：false 时视觉模块完全不加载、不调用、不计费
OCR_ENABLED=false
# A 层：无文本 PDF 页整页 OCR
OCR_PDF_SCANNED=false
# B 层：有文本但含图片/图表的 PDF 页整页描述
OCR_PDF_PAGE_IMAGES=false
# C 层：DOCX/PPTX 内嵌图片识别
OCR_EMBEDDED_IMAGES=false
# 图片长边上限（像素）与单文档视觉调用上限
OCR_MAX_IMAGE_EDGE=1600
OCR_MAX_PER_DOCUMENT=20
OCR_TIMEOUT_SECONDS=60
VISION_CACHE_DIR=./data/vision_cache
