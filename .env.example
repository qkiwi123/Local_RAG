# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（P1-1 实验选择中文 BGE large）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 仅查询侧前缀；留空表示不添加
EMBEDDING_QUERY_INSTRUCTION=

# 文件存储路径（相对于项目根目录）
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma_db
METADATA_DB_PATH=./data/metadata.db

# 文本切分参数
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# P1-3 正式评估选择的递归语义切分策略
CHUNK_STRATEGY=recursive
# bge-large-zh-v1.5 最大 512 token，保留 32 token 安全余量
CHUNK_MAX_TOKENS=480

# 检索返回数量
RETRIEVAL_TOP_K=5
# Chroma cosine distance 越小越相似；P1-4 真实评测校准值
RETRIEVAL_DISTANCE_THRESHOLD=0.67
# P2-1 实验开关：dense / bm25 / hybrid；通过消融验收前保持 dense
RETRIEVAL_MODE=dense
BM25_TOP_K=15
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# P1-5 高质量模式：Dense top15 经 bge-reranker-v2-m3 精排后返回 top5
# CPU 首次查询需要加载模型，实测平均总耗时约 9.3 秒；资源有限时可设为 false
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=15
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
